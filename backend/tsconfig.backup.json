{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  },
  "include": [
    "./src/**/*",
    "./config/**/*",
    "./database/**/*",
    "./types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".cache",
    ".tmp"
  ]
}
