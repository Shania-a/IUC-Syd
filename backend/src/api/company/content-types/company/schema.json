{
  "kind": "collectionType",
  "collectionName": "companies",
  "info": {
    "singularName": "company",
    "pluralName": "companies",
    "displayName": "Company"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "contactName": {
      "type": "string",
      "required": true
    },
    "contactEmail": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "contactPersons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact-person.contact-person",
      "mappedBy": "company"
    },
    "description": {
      "type": "text"
    },
    "industry": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    }
  }
}
